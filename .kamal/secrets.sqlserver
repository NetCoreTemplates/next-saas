# SQL Server destination secrets: read with `kamal <cmd> -d sqlserver`, after .kamal/secrets-common.
# DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# One operator-managed value, DB_PASSWORD, supplies both accounts:
#
#   MSSQL_SA_PASSWORD  sa account the image initializes
#   DB_PASSWORD        password for the next_saas application login created by
#                      config/db/sqlserver/pre-deploy.sh
#
# The application connects as next_saas, which owns only the next_saas database and is
# not a server administrator. Give sa its own secret if the two must differ.
DB_PASSWORD=$DB_PASSWORD
MSSQL_SA_PASSWORD=$DB_PASSWORD
