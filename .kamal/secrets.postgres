# PostgreSQL destination secrets: read with `kamal <cmd> -d postgres`, after .kamal/secrets-common.
# DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# POSTGRES_PASSWORD      superuser password for the postgres accessory
# NEXT_SAAS_DB_PASSWORD  password for the unprivileged next_saas application login
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
NEXT_SAAS_DB_PASSWORD=$NEXT_SAAS_DB_PASSWORD
