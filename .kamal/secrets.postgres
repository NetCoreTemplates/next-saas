# PostgreSQL destination secrets: read with `kamal <cmd> -d postgres`, after .kamal/secrets-common.
# DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# One operator-managed value, DB_PASSWORD, supplies both roles:
#
#   POSTGRES_PASSWORD  required by the postgres image to initialize the cluster superuser
#   DB_PASSWORD        password for the unprivileged application login created by
#                      config/db/postgres/init.sh
#
# The application still connects as a non-superuser role, so a compromised application
# cannot administer the cluster. Give the superuser its own secret if you also need the
# two passwords to differ.
DB_PASSWORD=$DB_PASSWORD
POSTGRES_PASSWORD=$DB_PASSWORD
