# MySQL destination secrets: read with `kamal <cmd> -d mysql`, after .kamal/secrets-common.
# DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# One operator-managed value, DB_PASSWORD, supplies both accounts:
#
#   MYSQL_ROOT_PASSWORD  root account the mysql image initializes
#   MYSQL_PASSWORD       password for the non-root next_saas application login
#
# The application connects as next_saas, which holds rights only over the next_saas
# database. Give root its own secret if you also need the two passwords to differ.
MYSQL_ROOT_PASSWORD=$DB_PASSWORD
MYSQL_PASSWORD=$DB_PASSWORD
