@using MyApp.Data
@inject SignInManager<ApplicationUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    var navItemCss = "identity-manage-link";
}

<ul class="identity-manage-list">
    <li class="@ManageNavPages.IndexNavClass(ViewContext)">
        <a class="@navItemCss" asp-page="./Index"><span>Profile</span><small>Personal details</small></a>
    </li>
    <li class="@ManageNavPages.EmailNavClass(ViewContext)">
        <a class="@navItemCss" asp-page="./Email"><span>Email</span><small>Address &amp; verification</small></a>
    </li>
    <li class="@ManageNavPages.ChangePasswordNavClass(ViewContext)">
        <a class="@navItemCss" asp-page="./ChangePassword"><span>Password</span><small>Sign-in credentials</small></a>
    </li>
    @if (hasExternalLogins)
    {
        <li class="@ManageNavPages.ExternalLoginsNavClass(ViewContext)">
            <a class="@navItemCss" asp-page="./ExternalLogins"><span>External logins</span><small>Connected providers</small></a>
        </li>
    }
    <li class="@ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)">
        <a class="@navItemCss" asp-page="./TwoFactorAuthentication"><span>Two-factor auth</span><small>Account protection</small></a>
    </li>
    <li class="@ManageNavPages.PersonalDataNavClass(ViewContext)">
        <a class="@navItemCss" asp-page="./PersonalData"><span>Personal data</span><small>Export or delete</small></a>
    </li>
    @if (HostContext.AppHost.HasPlugin<ApiKeysFeature>())
    {
        <li class="@ManageNavPages.ApiKeysNavClass(ViewContext)">
            <a class="@navItemCss" asp-page="./ApiKeys"><span>API keys</span><small>Programmatic access</small></a>
        </li>
    }
</ul>
