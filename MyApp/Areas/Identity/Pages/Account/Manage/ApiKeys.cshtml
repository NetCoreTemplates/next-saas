@page
@using Microsoft.AspNetCore.Html
@using MyApp.ServiceModel
@using ServiceStack.Data
@using ServiceStack.OrmLite
@inject IDbConnectionFactory DbFactory
@{
    ViewData["Title"] = "API Keys";
    ViewData["ActivePage"] = ManageNavPages.ApiKeys;
}

<div>
    <h1 class="mb-4 text-2xl font-semibold text-gray-900 dark:text-gray-100">
        @ViewData["Title"]
    </h1>
    <div data-component="pages/Account/Manage/ManageUserApiKeys.mjs" data-props="@ToProps()"></div>
</div>

@{
    IHtmlContent ToProps()
    {
        using var db = DbFactory.Open();
        var preference = db.SingleById<UserWorkspacePreference>(User.GetUserId());
        return Html.Raw(new {
            info = HostContext.AppHost.GetPlugin<ApiKeysFeature>()?.GetApiKeyInfo(),
            workspaceId = preference?.ActiveWorkspaceId,
        }.ToJson().HtmlEncode());
    }
}
