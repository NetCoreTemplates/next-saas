@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 class="@Css.H3">@ViewData["Title"]</h3>

@await Html.PartialAsync("AlertError", "Deleting this data removes your personal account, memberships, API keys, and notification history. An eligible individual workspace is scheduled for deletion; business organizations and shared data are not deleted with your account.")

@if (Model.OwnedOrganizations.Count > 0)
{
    <div class="mb-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900 dark:border-amber-400/20 dark:bg-amber-400/10 dark:text-amber-100">
        <p class="font-semibold">These owned accounts need attention before account deletion.</p>
        <p class="mt-1">Transfer or delete a business organization, or cancel paid billing and resolve any legal hold on an individual account:</p>
        <ul class="mt-2 list-disc pl-5">
            @foreach (var organization in Model.OwnedOrganizations)
            {
                <li>@organization</li>
            }
        </ul>
    </div>
}

<div>
    <form id="delete-user" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger text-center font-semibold" role="alert"></div>
        @if (Model.RequirePassword)
        {
            <div class="flex flex-col gap-y-4">
                <div>
                    <div>
                        <label asp-for="Input.Password" class="block text-sm font-medium text-gray-700 dark:text-gray-300"></label>
                        <div class="mt-1 relative">
                            <input asp-for="Input.Password" class="@Css.InputText" autocomplete="current-password" aria-required="true" placeholder="Please enter your password." />
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                </div>
            </div>

        }
        <div class="mt-4">
            <button type="submit" disabled="@(Model.OwnedOrganizations.Count > 0)" class="w-100 @Css.DangerButton disabled:cursor-not-allowed disabled:opacity-50">Delete data and close my account</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
