@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout !=  null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        // Layout = "/Areas/Identity/Pages/_Layout.cshtml";
        Layout = "/Pages/Shared/_Layout.cshtml";
    }
}

@section SettingsNavigation {
    <div class="identity-sidebar-heading">
        <p>Settings</p>
        <h2>Account</h2>
    </div>
    <nav class="identity-manage-nav" aria-label="Account settings">
        @await Html.PartialAsync("_ManageNav")
    </nav>
    <a href="/dashboard" class="identity-sidebar-return"><span aria-hidden="true">←</span> Back to organization</a>
}

<div class="identity-manage-body">
    @RenderBody()
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
