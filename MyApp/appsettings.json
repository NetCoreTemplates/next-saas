{
  "Database": {
    "Provider": "Sqlite"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "EnableSecurityHeaders": true,
    "RequireSameOriginForCookieApi": true,
    "AuthenticationRequestsPerMinute": 20,
    "ContentSecurityPolicy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'"
  },
  "Deployment": {
    "EnforceStartupChecks": true,
    "RequireHttps": true,
    "RequireNetworkDatabase": true,
    "RequireSmtp": true,
    "RequireStripe": true,
    "RequireStripeWebhook": true,
    "AllowTestStripeKeys": false,
    "RequireRestrictedHosts": true
  },
  "AppConfig": {
    "BaseUrl": "https://localhost:5001"
  },
  "Product": {
    "OrganizationName": "Acme",
    "ProductName": "Acme",
    "Description": "Secure document storage and analytics.",
    "SupportEmail": "support@example.com",
    "SalesEmail": "sales@example.com",
    "PrivacyUrl": "/privacy",
    "TermsUrl": "/terms"
  },
  "FileStorage": {
    "RootPath": "App_Data/files",
    "MaxFileBytes": 104857600,
    "AllowedExtensions": [ ".pdf", ".txt", ".md", ".csv", ".json", ".doc", ".docx", ".xls", ".xlsx", ".png", ".webp", ".jpg", ".jpeg", ".mp3", ".mp4" ]
  },
  "Notifications": {
    "FromName": "Acme",
    "FromEmail": "noreply@example.com",
    "Provider": "Development",
    "EnableInApp": true,
    "MaxAttempts": 5
  },
  "Saas": {
    "DefaultPlan": "free",
    "DefaultCurrency": "usd",
    "SupportedCurrencies": [ "usd" ],
    "EnablePersonalWorkspaces": true,
    "EnableTrials": true,
    "DefaultTrialDays": 14,
    "TrialRequiresPaymentMethod": false,
    "EnableAnnualBilling": true,
    "PastDueGraceDays": 7,
    "AfterGraceAccessMode": "FreeFallback",
    "EnableSupportAccess": false,
    "SupportAccessMaxMinutes": 60,
    "WorkspaceDeletionDelayDays": 7,
    "ExportExpiryDays": 7,
    "InvitationExpiryDays": 7,
    "AnalyticsRetentionDays": 365,
    "AuditRetentionDays": 730,
    "NotificationRetentionDays": 90,
    "DeletedFileRetentionDays": 30,
    "LifecycleHistoryRetentionDays": 365,
    "RetentionBatchSize": 1000,
    "EnableLegalHolds": true,
    "ApiKeyRequestsPerMinute": 120,
    "QuotaWarningPercentages": [ 80, 90, 100 ],
    "Features": [
      { "Key": "files.basic", "DisplayName": "File storage", "Description": "Upload, download, and delete files.", "Category": "Storage", "DefaultEnabled": true },
      { "Key": "analytics.basic", "DisplayName": "Usage analytics", "Description": "View current and historical usage.", "Category": "Analytics", "DefaultEnabled": true },
      { "Key": "analytics.advanced", "DisplayName": "Advanced analytics", "Description": "View usage breakdowns and projections.", "Category": "Analytics", "DefaultEnabled": false },
      { "Key": "api.access", "DisplayName": "API access", "Description": "Create and use organization API keys.", "Category": "Developer", "DefaultEnabled": false },
      { "Key": "audit.read", "DisplayName": "Audit logs", "Description": "View the organization audit trail.", "Category": "Security", "DefaultEnabled": false },
      { "Key": "branding.custom", "DisplayName": "Custom branding", "Description": "Customize customer-facing branding.", "Category": "Customization", "DefaultEnabled": false },
      { "Key": "support.community", "DisplayName": "Community support", "Description": "Access community support resources.", "Category": "Support", "DefaultEnabled": true }
    ],
    "Meters": [
      { "Key": "documents.stored", "DisplayName": "Documents stored", "UnitName": "document", "Kind": "Gauge", "Reset": "Never", "Aggregation": "Current", "DefaultEnforcement": "HardLimit" },
      { "Key": "storage.bytes", "DisplayName": "Storage", "UnitName": "byte", "Kind": "Gauge", "Reset": "Never", "Aggregation": "Maximum", "DefaultEnforcement": "HardLimit" },
      { "Key": "documents.uploaded", "DisplayName": "Documents uploaded", "UnitName": "document", "Kind": "Counter", "Reset": "BillingPeriod", "Aggregation": "Sum", "DefaultEnforcement": "SoftLimit" },
      { "Key": "api.requests", "DisplayName": "API requests", "UnitName": "request", "Kind": "Counter", "Reset": "BillingPeriod", "Aggregation": "Sum", "DefaultEnforcement": "HardLimit" }
    ]
  },
  "Stripe": {
    "PublishableKey": "",
    "SecretKey": "",
    "WebhookSecret": "",
    "PortalConfigurationId": "",
    "EnableCatalogProvisioning": true,
    "AllowLiveCatalogProvisioning": false
  }
}
