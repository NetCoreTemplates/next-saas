@inject MyApp.ServiceInterface.ProductConfig Product
@{
    var isAuthenticated = await Html.IsAuthenticatedAsync();
}
<header class="northstar-header">
    <div class="northstar-nav">
        <a href="/" class="northstar-brand" aria-label="@Product.ProductName home">
            <span class="identity-mark" aria-hidden="true">
                <span class="identity-mark-diamond"></span>
                <span class="identity-mark-dot"></span>
            </span>
            <span>@Product.ProductName</span>
        </a>

        <nav class="northstar-links" aria-label="Primary navigation">
            <a href="/" class="@(Html.MatchesPath("/") ? "active" : "")">Product</a>
            <a href="/pricing" class="@(Html.MatchesPath("/pricing") ? "active" : "")">Pricing</a>
        </nav>

        <div class="northstar-actions">
            @await Html.PartialAsync("DarkModeToggle")
            @if (!isAuthenticated)
            {
                <a href="/Identity/Account/Login" class="northstar-text-action">Sign in</a>
                <a href="/Identity/Account/Register" class="northstar-primary-action">Start free <span aria-hidden="true">→</span></a>
            }
            else
            {
                <a href="/dashboard" class="northstar-text-action">Organization</a>
                <a href="/Identity/Account/Manage" class="northstar-user" title="Manage account">
                    <img src="@User.GetPicture()" alt="" />
                    <span>@User.GetDisplayName()</span>
                </a>
                <form class="form-inline northstar-signout" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                    <button type="submit">Sign out</button>
                </form>
            }
        </div>
    </div>
</header>
