# Your private local file. Copy to .env, which is gitignored.
#
# Two things read it:
#   - the operator scripts and config/deploy.yml, for DB_PROVIDER, DB_PASSWORD, and Kamal;
#   - the application itself in Development, so any Key__Sub value here overrides
#     MyApp/appsettings.json and MyApp/appsettings.Development.json on your machine only.
#
# Nothing here reaches a deployment. Production values belong in
# MyApp/appsettings.Production.json and GitHub Actions secrets; see DATABASE.md and README.md.
# Keys already set in your environment always win over this file.

# See DATABASE.md for the step-by-step guide.
# Database provider for BOTH sides: the Kamal destination that deploys, and the engine
# ./scripts/dev-db.sh runs locally. One of sqlite, postgres, mysql, sqlserver.
DB_PROVIDER=sqlite

# Deployment password for a provider that runs a database server, used by the deployment
# scripts only. The local database uses DEV_DB_PASSWORD (default Dev_Passw0rd!Local).
# DB_PASSWORD=

# Local database, written by ./scripts/dev-db.sh up from DB_PROVIDER. Without these the
# application uses the SQLite default in MyApp/appsettings.Development.json. Set them by hand
# only for a database this template does not provision, such as a managed instance.
# Database__Provider=PostgreSql
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=next_saas;Username=next_saas;Password=REPLACE_ME

# Stripe sandbox keys for local development. Leave them unset to work on Free plan flows;
# paid actions then return a descriptive configuration error.
# Stripe__PublishableKey=pk_test_REPLACE_ME
# Stripe__SecretKey=sk_test_REPLACE_ME
# Stripe__WebhookSecret=whsec_REPLACE_ME
# Stripe__PortalConfigurationId=

# Local email. In-app notifications work without SMTP, and Development captures confirmation
# links instead of sending them.
# Notifications__Provider=Development
# Notifications__FromName=Acme
# Notifications__FromEmail=noreply@example.com

# ---------------------------------------------------------------------------------------
# Deployment values. These are listed for reference and are deliberately commented out,
# because the application would otherwise apply them to your local Development run. Put them
# in MyApp/appsettings.Production.json, or in a separate .env.production used by preflight.
# ---------------------------------------------------------------------------------------

# Public/base URL
# AppConfig__BaseUrl=https://saas.example.com
# AllowedHosts=saas.example.com
# ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# Browser/API security baseline
# Security__EnableSecurityHeaders=true
# Security__RequireSameOriginForCookieApi=true
# Security__AuthenticationRequestsPerMinute=20

# Production SMTP (required by the default production policy)
# Notifications__Provider=Smtp
# SmtpConfig__Host=smtp.example.com
# SmtpConfig__Port=587
# SmtpConfig__UserName=REPLACE_ME
# SmtpConfig__Password=REPLACE_ME
# SmtpConfig__FromEmail=noreply@your-domain.com
# Product__SupportEmail=support@your-domain.com

# Production safety policy. Disable an individual requirement only deliberately.
# Deployment__EnforceStartupChecks=true
# Deployment__RequireNetworkDatabase=true
# Deployment__RequireExplicitMigrations=true
# Deployment__RequireSmtp=true
# Deployment__RequireStripe=true
# Deployment__RequireStripeWebhook=true
# Deployment__AllowTestStripeKeys=false
