{
  "AppConfig": {
    "BaseUrl": "https://saas.example.com"
  },
  "ASPNETCORE_FORWARDEDHEADERS_ENABLED": true,
  "AllowedHosts": "saas.example.com",
  "Database": {
    "Provider": "MySql",
    "AutoMigrateEmpty": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=mysql.example.com;Port=3306;Database=acme;User Id=acme;Password=REPLACE_ME;SslMode=Required"
  },
  "BootstrapAdmin": {
    "Email": "admin@saas.example.com",
    "Password": "REPLACE_WITH_A_UNIQUE_PASSWORD",
    "DisplayName": "Platform Administrator"
  },
  "Product": {
    "SupportEmail": "support@example.com",
    "SalesEmail": "sales@example.com"
  },
  "Notifications": {
    "Provider": "Smtp",
    "FromName": "Acme",
    "FromEmail": "noreply@example.com"
  },
  "SmtpConfig": {
    "Host": "smtp.example.com",
    "Port": 587,
    "UserName": "REPLACE_ME",
    "Password": "REPLACE_ME",
    "FromEmail": "noreply@example.com"
  },
  "Stripe": {
    "PublishableKey": "pk_live_REPLACE_ME",
    "SecretKey": "sk_live_REPLACE_ME",
    "WebhookSecret": "whsec_REPLACE_ME",
    "PortalConfigurationId": ""
  },
  "Deployment": {
    "EnforceStartupChecks": true,
    "RequireHttps": true,
    "RequireRestrictedHosts": true,
    "RequireNetworkDatabase": true,
    "RequireExplicitMigrations": true,
    "RequireSmtp": true,
    "RequireStripe": true,
    "RequireStripeWebhook": true,
    "AllowTestStripeKeys": false
  }
}
